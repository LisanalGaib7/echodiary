# ============================================================
# Echo — environment variables
# Copy to .env (local) or configure in your hosting platform.
# ============================================================

# --- AI provider selection ---
# One of: lovable | openai | openrouter | gemini
AI_PROVIDER=lovable

# Provide the key for the selected provider only.
LOVABLE_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# --- Security ---
# Comma-separated list of origins allowed to call AI server functions.
# Example: https://echodiarycorrector.lovable.app,https://echo.example.com
# Leave empty in local dev.
ALLOWED_ORIGINS=

# Cloudflare Turnstile secret (optional but recommended in production).
# If set, the diary form must submit a Turnstile token.
# TURNSTILE_SECRET=
# VITE_TURNSTILE_SITE_KEY=   # publishable — safe to expose to the browser

# --- Feedback (Settings page + desktop FAB) ---
# Delivered via a Telegram bot. Without these, sending feedback fails with
# a "not configured" error — the rest of the app is unaffected.
# 1. Create a bot with @BotFather, get the token.
# 2. Message the bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
